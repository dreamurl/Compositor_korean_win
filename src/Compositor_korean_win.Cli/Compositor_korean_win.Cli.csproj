<Project Sdk="Microsoft.NET.Sdk">

  <!-- `compositor`: the console command an assistant runs to work in the open window
       (docs/progress.md 26). A console exe of its own because the editor is a GUI exe, which a
       shell neither waits for nor reads. It speaks only to the window's pipe, so it references
       nothing of the editor and stays small. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Compositor_korean_win.Cli</RootNamespace>
    <AssemblyName>compositor</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

</Project>
