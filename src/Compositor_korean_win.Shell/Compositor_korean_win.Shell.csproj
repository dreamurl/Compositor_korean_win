<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Compositor_korean_win.Shell</RootNamespace>
    <AssemblyName>Compositor_korean_win</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Warnings stay warnings here: this project's surface is other people's
         interop signatures. Core, which this port owns outright, treats them as errors. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Upstream's own icon (MIT), packed from its asset catalogue's PNGs. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- Korean is the default; English is carried alongside it from M6 on. -->
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Single self-contained exe, no runtime install, no JIT warm-up. M0 measures what this costs. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantTimezone>true</InvariantTimezone>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <!-- NativeAOT on Windows defaults to the OS thread pool; the tests and every JIT run use the
         portable one. A dump of a distortion drag stuck forever showed the UI thread waiting in
         QuadWarp's Parallel.For with its replica never run: no managed worker anywhere, only idle
         OS pool threads. Using the same pool the tests exercise removes that divergence. -->
    <UseWindowsThreadPool>false</UseWindowsThreadPool>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compositor_korean_win.Core\Compositor_korean_win.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <!--
    M7: two builds from one source. The AI build (the default) references ONNX Runtime with
    DirectML and ships its DLLs and the model beside the exe; the plain build (-p:WithAi=false)
    references none of it: no runtime to load, nothing of it in the exe (its managed half is about
    0.7 MB of the AI build's), and nothing a missing DLL could break.
  -->
  <PropertyGroup>
    <WithAi Condition="'$(WithAi)' == ''">true</WithAi>
  </PropertyGroup>

  <ItemGroup Condition="'$(WithAi)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <Compile Remove="Ai\SubjectModels.None.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(WithAi)' != 'true'">
    <Compile Remove="Ai\OnnxSubjectModel.cs" />
    <Compile Remove="Ai\SubjectModels.Onnx.cs" />
  </ItemGroup>

  <!--
    The C kernels are linked straight in: [LibraryImport("compositor_kernels")] binds at link time,
    so the shipped executable carries no kernel DLL beside it. KernelLibraryPath is set by CI after
    CMake builds the static library; without it the build falls back to loading a DLL at run time.
  -->
  <ItemGroup Condition="'$(KernelLibraryPath)' != ''">
    <DirectPInvoke Include="compositor_kernels" />
    <NativeLibrary Include="$(KernelLibraryPath)" />
  </ItemGroup>

</Project>
